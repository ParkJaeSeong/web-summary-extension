{
  "name": "pagemind-browser-extension",
  "version": "0.1.0",
  "private": true,
  "author": "PageMind contributors",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "cross-env NODE_ENV='dev' node build.mjs",
    "build": "cross-env NODE_ENV='production' node build.mjs",
    "package": "pnpm build",
    "verify:package": "node scripts/verify-reproducible-build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .js,.mjs,.jsx,.ts,.tsx src scripts build.mjs vitest.config.ts",
    "lint:fix": "eslint --ext .js,.mjs,.jsx,.ts,.tsx src scripts build.mjs vitest.config.ts --fix",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss,html}\" \"scripts/**/*.mjs\" build.mjs vitest.config.ts package.json tsconfig.json .eslintrc.json \"docs/**/*.md\" \"*.md\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss,html}\" \"scripts/**/*.mjs\" build.mjs vitest.config.ts package.json tsconfig.json .eslintrc.json \"docs/**/*.md\" \"*.md\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "prepare": "husky install",
    "watch": "chokidar src -c 'npm run dev'"
  },
  "dependencies": {
    "@geist-ui/core": "^2.3.8",
    "eventsource-parser": "^0.0.5",
    "pdfjs-dist": "^3.11.174",
    "preact": "^10.13.1",
    "react": "npm:@preact/compat@^17.1.2",
    "react-dom": "npm:@preact/compat@^17.1.2",
    "react-markdown": "^8.0.4",
    "webextension-polyfill": "^0.10.0"
  },
  "devDependencies": {
    "@types/chrome": "0.2.6",
    "@types/fs-extra": "^9.0.13",
    "@types/node": "22.20.1",
    "@types/react": "17.0.44",
    "@types/webextension-polyfill": "^0.9.2",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "archiver": "^5.3.1",
    "chokidar-cli": "^3.0.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.17.4",
    "esbuild-style-plugin": "^1.6.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-react": "^7.31.11",
    "eslint-plugin-react-hooks": "^4.6.0",
    "fake-indexeddb": "6.2.4",
    "fs-extra": "^11.1.0",
    "husky": "^8.0.0",
    "jsdom": "25.0.1",
    "lint-staged": "^13.1.0",
    "prettier": "^2.8.0",
    "prettier-plugin-organize-imports": "^3.2.1",
    "sass": "^1.57.1",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "lint-staged": {
    "src/*.{js,jsx,ts,tsx,mjs}": [
      "npx prettier --write",
      "npx eslint --fix"
    ]
  },
  "resolutions": {
    "@types/react": "17.0.44"
  }
}
